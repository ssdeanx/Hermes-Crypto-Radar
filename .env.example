# ═══════════════════════════════════════════════════════════════════════
# Hermes Crypto Radar — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════
# All env vars are prefixed with RADAR__ and are OPTIONAL.
# Uncomment and set to override defaults.
#
# Run: RADAR__LOG_LEVEL=debug crypto-radar scan
# ═══════════════════════════════════════════════════════════════════════

# Data directory for logs and cached state
# Default: ~/.hermes/data/crypto-radar
# RADAR__DATA_DIR=~/.hermes/data/crypto-radar

# Log level: trace, debug, info, warn, error
# Default: info
# RADAR__LOG_LEVEL=info

# Strategy weights (JSON) for signal scoring
# Default: {"momentum":0.4,"mean-reversion":0.2,"trend-following":0.4}
# RADAR__STRATEGY_WEIGHTS={"momentum":0.4,"mean-reversion":0.2,"trend-following":0.4}

# Timeframe weights (JSON) for multi-timeframe aggregation
# Default: {"15m":0.1,"1h":0.25,"4h":0.3,"1d":0.35}
# RADAR__TIMEFRAME_WEIGHTS={"15m":0.1,"1h":0.25,"4h":0.3,"1d":0.35}

# Token whitelist (JSON array or comma-separated) — if set, only these tokens are scanned
# Default: all known tokens
# RADAR__TOKENS=["bitcoin","ethereum","solana"]

# Binance data API base URL
# Default: https://data-api.binance.vision
# RADAR__BINANCE_BASE_URL=https://data-api.binance.vision

# HTTP request timeout in milliseconds
# Default: 10000
# RADAR__FETCH_TIMEOUT_MS=10000

# Cache TTL in milliseconds
# Default: 300000 (5 minutes)
# RADAR__CACHE_TTL_MS=300000

# DeFiLlama on-chain metrics enabled during scan
# Default: false
# RADAR__DEFI_LLAMA_ENABLED=true
