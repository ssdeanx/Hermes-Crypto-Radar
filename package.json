{
  "name": "@sam/hermes-crypto-radar",
  "version": "1.2.0",
  "description": "Hermes Agent plugin — Crypto market radar: multi-chain token tracking, technical analysis, news signals, alerting, XLSX export, and warm daemon",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "crypto-radar": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./prices": "./dist/prices.js",
    "./news": "./dist/news.js",
    "./signals": "./dist/signals.js"
  },
  "files": [
    "dist",
    "plugin.yaml",
    "plugin",
    "crypto-radar.json",
    "README.md",
    "SPEC.md"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/cli.js",
    "radar": "node dist/cli.js",
    "daemon": "node dist/cli.js daemon",
    "daemon:status": "node dist/cli.js daemon --status",
    "daemon:stop": "node dist/cli.js daemon --stop",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "hermes",
    "hermes-agent",
    "hermes-plugin",
    "crypto",
    "cryptocurrency",
    "trading",
    "binance",
    "solana",
    "polygon",
    "sui",
    "aptos",
    "sei",
    "injective",
    "thorchain",
    "cosmos",
    "celestia",
    "technical-analysis",
    "market-radar",
    "trading-signals"
  ],
  "author": "Sam",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "asciichart": "^1.5.25",
    "commander": "^13.1.0",
    "csv-stringify": "^6.5.2",
    "exceljs": "^4.4.0",
    "node-fetch": "^3.3.2",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^3.0.0",
    "husky": "^9.1.7",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
